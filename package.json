{
  "name": "zantro",
  "version": "1.0.0",
  "description": "Zantro — Lecteur multimédia local moderne et minimaliste pour vos films et vidéos.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "video-player",
    "media-center",
    "mp4",
    "mkv",
    "electron",
    "netflix-style",
    "zantro"
  ],
  "author": "sixovo",
  "license": "MIT",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.zantro.app",
    "productName": "Zantro",
    "icon": "assets/icon.png",
    "asarUnpack": [
      "node_modules/@ffmpeg-installer/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "locales/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}
